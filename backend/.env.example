# ─────────────────────────────────────────────────────────────
# FitAI backend configuration. Copy to backend/.env and edit.
# NEVER commit backend/.env — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database. SQLite for local dev; PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://fitai:password@localhost:5432/fitai
DATABASE_URL=sqlite:///./fitai.db

# Auth — REQUIRED in production. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-.env-this-is-only-for-local-dev
JWT_EXPIRE_MINUTES=10080

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ── AI ──────────────────────────────────────────────────────
# auto (Gemini → Groq → demo) | gemini | groq | mock
AI_PROVIDER=auto
# Free key: https://aistudio.google.com/apikey  (leave empty for demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional alternative: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_REQUESTS_PER_MINUTE=20
AUTH_REQUESTS_PER_MINUTE=20

# ── Email verification (FREE with Gmail) ────────────────────
# New users must enter a 6-digit code sent to their email.
# If SMTP is empty in development, the code is printed in the backend terminal instead.
# Gmail: turn on 2-Step Verification, then create an App Password at
#        https://myaccount.google.com/apppasswords  (16 letters, no spaces)
EMAIL_VERIFICATION_REQUIRED=true
# Email a fresh 6-digit code on EVERY login (two-step login)
LOGIN_OTP_REQUIRED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FitAI <your.address@gmail.com>
SMTP_USE_TLS=true
VERIFICATION_CODE_MINUTES=15

# ── External data APIs (no keys required) ───────────────────
ENABLE_EXTERNAL_APIS=true
OFF_BASE_URL=https://world.openfoodfacts.org
# Open Food Facts asks every app to identify itself (AppName/Version (contact))
OFF_USER_AGENT=FitAI/1.0 (local development; you@example.com)
WGER_BASE_URL=https://wger.de/api/v2
EXTERNAL_TIMEOUT_SECONDS=6
