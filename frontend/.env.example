# Frontend build-time variables (all public — never put secrets here).
# Leave VITE_API_URL empty to use the same-origin /api path (dev proxy or nginx).
VITE_API_URL=
# On Vercel set it to your Render API, ending in /api, e.g. https://fitai-api.onrender.com/api
# Dev server proxy target for /api
VITE_API_PROXY=http://127.0.0.1:8000
